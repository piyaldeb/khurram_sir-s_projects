# Odoo connection used by the report site (server-side only, never shipped to the browser).
ODOO_URL=https://taps.odoo.com
# Database name. Leave blank only if the server exposes exactly one database.
ODOO_DB=
# ODOO_USERNAME works as an alias for ODOO_LOGIN.
ODOO_LOGIN=
# Password, or better: an API key from Preferences > Account Security > New API Key.
ODOO_PASSWORD=
ODOO_TZ=Asia/Dhaka
ODOO_LANG=en_US
PORT=4321

# --- Supabase: stores the budget months (the data Odoo does not hold) ---------
# Leave these blank to fall back to JSON files under data/.
# Settings > API in the Supabase dashboard.
SUPABASE_URL=https://<project-ref>.supabase.co
# The service-role key. Server-side only - never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=budget_months
# Pooler region, only used by `npm run db:create`. Discovered automatically
# if left blank.
SUPABASE_DB_REGION=

# How long the current month's Odoo figures stay fresh before a page load
# re-fetches them.
ODOO_SYNC_FRESH_MINUTES=15

# --- OT cost -----------------------------------------------------------------
# Odoo reports overtime in taka. The OT Cost page looks today's USD/BDT rate up
# on the web (no API key needed) and prints it beside the figures.
# Set FX_LIVE=0 to pin every figure to OT_USD_RATE instead - 120 is the flat rate
# the OT Cost workbook uses, so pinning is what reproduces its dollar figures.
FX_LIVE=1
OT_USD_RATE=120
# How long a looked-up rate stays fresh, in hours.
FX_FRESH_HOURS=6
# Earliest OT month offered. Odoo answers with real data from April 2023.
OT_EARLIEST_MONTH=2023-04
# Attendance reports one request may build. A month costs three.
OT_FETCH_PER_REQUEST=6

