---
import '../styles/app.css';

interface Props {
  title: string;
  connected?: boolean;
  connectionLabel?: string;
}

const { title, connected = false, connectionLabel = 'Not connected' } = Astro.props;
const path = Astro.url.pathname;

/**
 * The Sales module. Reports that read the order book rather than the floor sit
 * behind their own menu, so the top row stays the manufacturing reports and the
 * sales ones can grow without pushing them off the side.
 */
const sales = [
  { href: '/oa-released', label: 'OA released', hint: 'Bulk orders let go to the floor' },
];
const inSales = sales.some((item) => path.startsWith(item.href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Manufacturing reports read live from Odoo over JSON-RPC." />
    <script is:inline>
      // Restore the theme before first paint so the toggle never flashes.
      const stored = localStorage.getItem('mrp-theme');
      if (stored) document.documentElement.dataset.theme = stored;
    </script>
  </head>
  <body>
    <div class="app">
      <header class="topbar">
        <div class="brand">
          <span>Manufacturing Reports</span>
          <small>Odoo · JSON-RPC</small>
        </div>
        <nav class="nav" aria-label="Sections" id="site-nav">
          <a href="/" class:list={['nav-link', { active: path === '/' }]}>Production report</a>
          <div class="nav-group" data-nav-group>
            <button
              type="button"
              class:list={['nav-link', 'nav-trigger', { active: inSales }]}
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="nav-sales"
            >
              Sales
              <span class="nav-caret" aria-hidden="true">▾</span>
            </button>
            <div class="nav-menu" id="nav-sales" role="menu" aria-label="Sales">
              {
                sales.map((item) => (
                  <a
                    href={item.href}
                    role="menuitem"
                    class:list={['nav-menu-item', { active: path.startsWith(item.href) }]}
                  >
                    <strong>{item.label}</strong>
                    <small>{item.hint}</small>
                  </a>
                ))
              }
            </div>
          </div>
          <a href="/budget" class:list={['nav-link', { active: path.startsWith('/budget') }]}>
            Budget follow-up
          </a>
          <a href="/analytics" class:list={['nav-link', { active: path.startsWith('/analytics') }]}>
            Production ABC
          </a>
          <a href="/ot-cost" class:list={['nav-link', { active: path.startsWith('/ot-cost') }]}>
            OT cost
          </a>
          <a href="/ageing" class:list={['nav-link', { active: path.startsWith('/ageing') }]}>
            180+ stock
          </a>
          <a
            href="/sample-leadtime"
            class:list={['nav-link', { active: path.startsWith('/sample-leadtime') }]}
          >
            Lead time
          </a>
        </nav>
        <div class="topbar-spacer"></div>
        <div class="conn" title={connectionLabel}>
          <span class={connected ? 'dot' : 'dot off'}></span>
          <span class="conn-label">{connectionLabel}</span>
        </div>
        <button class="btn" id="theme-toggle" type="button" aria-label="Toggle colour theme">
          Theme
        </button>
      </header>
      <slot />
    </div>

    <script is:inline>
      /*
       * The Sales menu opens on hover in CSS. This adds the ways a pointer
       * cannot: click and Enter for touch and keyboard, Escape to close, and a
       * click anywhere else to dismiss. `data-open` only ever adds to what
       * :hover and :focus-within already do.
       */
      document.querySelectorAll('[data-nav-group]').forEach((group) => {
        const trigger = group.querySelector('.nav-trigger');
        if (!trigger) return;

        const setOpen = (open) => {
          group.toggleAttribute('data-open', open);
          trigger.setAttribute('aria-expanded', String(open));
        };

        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          setOpen(!group.hasAttribute('data-open'));
        });

        group.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          setOpen(false);
          trigger.focus();
        });

        // Hovering back out is the pointer's own dismissal; this catches taps.
        document.addEventListener('click', (event) => {
          if (!group.contains(event.target)) setOpen(false);
        });
      });

      // Light is the default, so the toggle only has to flip the explicit stamp.
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('mrp-theme', next);
      });
    </script>
  </body>
</html>
