---
import Base from '../layouts/Base.astro';
import { config, getSession } from '../lib/odoo';
import { yesterdayIso } from '../lib/dayReport';

export const prerender = false;

let session: Awaited<ReturnType<typeof getSession>> | null = null;
let odooError: string | null = null;

try {
  session = await getSession();
} catch (err) {
  odooError = (err as Error).message;
}

const date = yesterdayIso();
const today = new Date().toISOString().slice(0, 10);

const connectionLabel = session
  ? `${session.userName} · ${session.db} · ${new URL(config.url).host}`
  : 'Not connected';
---

<Base title="Production report · Odoo" connected={!!session} connectionLabel={connectionLabel}>
  <main class="main production" data-date={date} data-today={today} data-odoo={session ? '1' : ''}>
    <header class="page-head">
      <div class="page-head-text">
        <p class="eyebrow">Manufacturing</p>
        <h1>Production report</h1>
        <p class="lede">
          The daily MRP Invoice sheet, read live from Odoo for each company. Opens on
          yesterday, because today's shift is still running.
        </p>
      </div>

      <div class="page-head-actions">
        <div class="period-picker">
          <button class="step" type="button" id="day-prev" aria-label="Previous day">‹</button>
          <input type="date" id="day" value={date} max={today} />
          <button class="step" type="button" id="day-next" aria-label="Next day">›</button>
        </div>
        <button class="chip" type="button" id="day-yesterday">Yesterday</button>
        <button class="btn" id="day-refresh" type="button">Refresh</button>
      </div>
    </header>

    {
      odooError && (
        <div class="panel state error banner">
          <h2>Odoo is not connected</h2>
          <p>{odooError}</p>
        </div>
      )
    }

    <div class="day-layout">
      <!-- The four things this page is opened to find out. -->
      <aside class="day-rail" id="day-rail"></aside>

      <section class="day-main">
        <div class="chips-bar panel" id="group-chips" role="group" aria-label="Column groups"></div>
        <div class="panel card day-card">
          <div class="table-scroll" id="day-grid" style="max-height:none"></div>
        </div>
        <p class="hint" id="day-note"></p>
      </section>
    </div>
  </main>

  <script src="../scripts/production.ts"></script>
</Base>
