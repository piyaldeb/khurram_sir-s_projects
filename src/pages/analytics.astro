---
import Base from '../layouts/Base.astro';
import { config, getSession } from '../lib/odoo';
import { fyLabel, fyOf, plannedMonths } from '../lib/budget';

export const prerender = false;

let session: Awaited<ReturnType<typeof getSession>> | null = null;
let odooError: string | null = null;

try {
  session = await getSession();
} catch (err) {
  odooError = (err as Error).message;
}

const fys = [...new Set(plannedMonths().map(fyOf))].sort((a, b) => b - a);
const currentFy = fys[0] ?? new Date().getFullYear();

const connectionLabel = session
  ? `${session.userName} · ${session.db} · ${new URL(config.url).host}`
  : 'Not connected';
---

<Base title="Production ABC · Odoo" connected={!!session} connectionLabel={connectionLabel}>
  <main class="main abc" data-fy={String(currentFy)} data-odoo={session ? '1' : ''}>
    <header class="page-head">
      <div class="page-head-text">
        <p class="eyebrow">Manufacturing</p>
        <h1>Production ABC</h1>
      </div>

      <div class="page-head-actions">
        <div class="segmented" role="tablist" aria-label="Company" id="company-seg">
          <button class="seg" type="button" role="tab" data-company="all" aria-selected="true">
            All companies
          </button>
        </div>
        <div class="segmented" role="tablist" aria-label="Fiscal year">
          {fys.map((fy) => (
            <button
              class="seg"
              type="button"
              role="tab"
              data-fy-pick={String(fy)}
              aria-selected={fy === currentFy ? 'true' : 'false'}
            >
              {fyLabel(fy)}
            </button>
          ))}
        </div>
      </div>
    </header>

    {
      odooError && (
        <div class="panel state error banner">
          <h2>Odoo is not connected</h2>
          <p>{odooError}</p>
        </div>
      )
    }

    <div class="panel state" id="abc-status">
      <h2><span class="spinner"></span> Building the year</h2>
      <p>
        The first run asks Odoo for each month's packing report and caches it — that can take a
        couple of minutes. After that, only the current month refreshes.
      </p>
    </div>

    <div class="day-layout" id="abc-body" hidden>
      <!-- The rail carries the judgment; the grid carries every row. -->
      <aside class="day-rail" id="abc-rail"></aside>

      <section class="day-main">
        <div class="chips-bar panel" id="abc-chips"></div>

        <section class="panel card">
          <div class="card-head">
            <h2>Pareto — value per item, cumulative share</h2>
            <span class="hint" id="pareto-note"></span>
          </div>
          <div class="chart-host" id="chart-pareto"></div>
        </section>

        <div class="panel card day-card" style="margin-top:16px">
          <div class="table-scroll" id="abc-grid" style="max-height:none"></div>
        </div>
        <p class="hint" id="abc-note"></p>
      </section>
    </div>
  </main>

  <script src="../scripts/analytics.ts"></script>
</Base>
